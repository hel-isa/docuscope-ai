APP_NAME=DocuScope AI
PRIVACY_MODE=strict
OUTPUT_DIR=./outputs
REVIEW_CONFIDENCE_THRESHOLD=0.75

# GenAI (Anthropic Claude) fallback layer.
# Leave ANTHROPIC_API_KEY empty to run rules-only (no AI calls, no cost).
AI_ENABLED=true
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TIMEOUT_SECONDS=20
ANTHROPIC_MAX_RETRIES=2

# AppSec: resource-exhaustion guards applied before/while parsing untrusted files.
MAX_FILE_SIZE_BYTES=50000000
MAX_PDF_PAGES=500
MAX_ZIP_UNCOMPRESSED_BYTES=200000000
MAX_IMAGE_PIXELS=50000000

# Local FastAPI demo: optional, off by default. When set, /scan rejects any
# input folder that resolves outside this root.
API_ALLOWED_ROOT=
